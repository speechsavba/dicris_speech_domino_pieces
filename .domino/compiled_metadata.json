                    "title": "audio to asses",
                    "type": "string"
                },
                "sr": {
                    "default": 192000,
                    "description": "Sampling frequency of sound (integer)",
                    "title": "Sampling frequency of sound",
                    "type": "integer"
                }
            },
            "title": "InputModel",
            "type": "object"
        },
        "output_schema": {
            "properties": {
                "contamination": {
                    "default": 0.0,
                    "description": "Contamination of insulator from sound (float)",
                    "title": "Contamination",
                    "type": "number"
                }
            },
            "title": "OutputModel",
            "type": "object"
        },
        "secrets_schema": null,
        "source_url": null
